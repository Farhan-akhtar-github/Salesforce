<?xml version="1.0" encoding="UTF-8" ?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Asset Tracker User</label>
    <description
  >Grants access to the Asset Tracker app: full CRUD on Tracked Assets, visibility of the app and its tabs, and access to the AssetTrackerController class.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <license>Salesforce</license>
    <applicationVisibilities>
        <application>Asset_Tracker</application>
        <visible>true</visible>
    </applicationVisibilities>
    <objectPermissions>
        <object>Tracked_Asset__c</object>
        <allowCreate>true</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>true</allowEdit>
        <allowDelete>true</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <fieldPermissions>
        <field>Tracked_Asset__c.Serial_Number__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Tracked_Asset__c.Status__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Tracked_Asset__c.Category__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Tracked_Asset__c.Assigned_To__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Tracked_Asset__c.Purchase_Date__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Tracked_Asset__c.Purchase_Price__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Tracked_Asset__c.Location__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <tabSettings>
        <tab>Tracked_Asset__c</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>Asset_Tracker_Home</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <classAccesses>
        <apexClass>AssetTrackerController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
</PermissionSet>
