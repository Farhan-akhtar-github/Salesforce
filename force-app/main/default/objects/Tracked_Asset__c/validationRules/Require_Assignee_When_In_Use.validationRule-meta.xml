<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Assignee_When_In_Use</fullName>
    <active>true</active>
    <description>An asset marked In Use must have an assignee.</description>
    <errorConditionFormula
  >AND(ISPICKVAL(Status__c, "In Use"), ISBLANK(Assigned_To__c))</errorConditionFormula>
    <errorDisplayField>Assigned_To__c</errorDisplayField>
    <errorMessage>Assigned To is required when Status is In Use.</errorMessage>
</ValidationRule>
